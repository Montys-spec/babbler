  {
    "id": "geschlecht", "topic": "Substantive & Adjektive", "rule": "artikel",
    "title": "Geschlecht der Nomen",
    "intro": "Jedes italienische Nomen ist männlich oder weiblich – ein Neutrum gibt es nicht. Meist verrät die Endung das Geschlecht.",
    "table": { "head": ["Endung", "Geschlecht", "Beispiel"], "rows": [
      ["-o", "meist männlich", "il libro"],
      ["-a", "meist weiblich", "la casa"],
      ["-e", "beides möglich", "il pane · la chiave"],
      ["-zione, -tà", "weiblich", "la stazione · la città"]
    ] },
    "tips": [
      "Ausnahmen: la mano, la foto, la radio sind weiblich; il problema, il sistema, il programma sind männlich.",
      "Das Deutsche hilft nicht: das Haus = la casa (weiblich), die Tomate = il pomodoro (männlich). Wörter auf -e immer mit Artikel lernen."
    ],
    "exercises": [
      { "text": "___ libro è sul tavolo.", "answer": "Il", "options": ["Il", "La", "Lo"], "de": "Das Buch liegt auf dem Tisch.", "why": "„libro“ endet auf -o → männlich: „il“." },
      { "text": "___ casa è piccola.", "answer": "La", "options": ["La", "Il", "Lo"], "de": "Das Haus ist klein.", "why": "„casa“ endet auf -a → weiblich: „la“." },
      { "text": "___ stazione è lontana.", "answer": "La", "options": ["La", "Il", "Lo"], "de": "Der Bahnhof ist weit weg.", "why": "Wörter auf -zione sind weiblich." },
      { "text": "___ città è bellissima.", "answer": "La", "options": ["La", "Il", "Lo"], "de": "Die Stadt ist wunderschön.", "why": "Wörter auf -tà sind weiblich." },
      { "text": "___ problema è grave.", "answer": "Il", "options": ["Il", "La", "Lo"], "de": "Das Problem ist ernst.", "why": "Ausnahme: „problema“ ist männlich (trotz -a)." },
      { "text": "Mi fa male ___ mano.", "answer": "la", "options": ["la", "il", "lo"], "de": "Mir tut die Hand weh.", "why": "Ausnahme: „mano“ ist weiblich (trotz -o)." },
      { "text": "___ chiave è nella borsa.", "answer": "La", "options": ["La", "Il", "Lo"], "de": "Der Schlüssel ist in der Tasche.", "why": "„chiave“ (-e) ist weiblich – Wörter auf -e mit Artikel lernen." },
      { "text": "___ pane è fresco.", "answer": "Il", "options": ["Il", "La", "Lo"], "de": "Das Brot ist frisch.", "why": "„pane“ (-e) ist männlich." }
    ]
  },
  {
    "id": "artikel", "topic": "Substantive & Adjektive", "rule": "artikel",
    "title": "Artikel: il, lo, l', la – un, uno, una",
    "intro": "Welcher Artikel passt, hängt vom Geschlecht und vom ersten Laut des Wortes ab.",
    "table": { "head": ["Wort beginnt mit …", "männlich", "weiblich"], "rows": [
      ["Konsonant", "il / un · il libro, un libro", "la / una · la casa, una casa"],
      ["s + Konsonant, z, gn, ps", "lo / uno · lo zio, uno studente", "la / una · la scuola"],
      ["Vokal", "l' / un · l'amico, un amico", "l' / un' · l'amica, un'amica"]
    ] },
    "tips": [
      "Männlich „un“ bekommt nie einen Apostroph: un amico. Nur weiblich wird es zu un': un'amica.",
      "Ob „lo“ oder „il“ hängt nur vom Anfang des nächsten Wortes ab: il ragazzo, aber lo zaino."
    ],
    "exercises": [
      { "text": "___ zaino è pesante.", "answer": "Lo", "options": ["Lo", "Il", "La"], "de": "Der Rucksack ist schwer.", "why": "Vor z steht „lo“." },
      { "text": "___ studente studia.", "answer": "Lo", "options": ["Lo", "Il", "La"], "de": "Der Student lernt.", "why": "Vor s + Konsonant steht „lo“." },
      { "text": "___amico di Marco è simpatico.", "answer": "L'", "options": ["L'", "Il", "Lo"], "de": "Marcos Freund ist nett.", "why": "Vor Vokal wird der Artikel zu „l'“." },
      { "text": "Ho ___ fratello e una sorella.", "answer": "un", "options": ["un", "uno", "una"], "de": "Ich habe einen Bruder und eine Schwester.", "why": "Männlich vor Konsonant: „un“." },
      { "text": "Cerco ___ specchio.", "answer": "uno", "options": ["uno", "un", "una"], "de": "Ich suche einen Spiegel.", "why": "Vor s + Konsonant: „uno“." },
      { "text": "Vorrei ___insalata.", "answer": "un'", "options": ["un'", "un", "una"], "de": "Ich hätte gern einen Salat.", "why": "„insalata“ ist weiblich und beginnt mit Vokal → „un'“." },
      { "text": "È ___ amico mio.", "answer": "un", "options": ["un", "un'", "uno"], "de": "Er ist ein Freund von mir.", "why": "Männlich: „un“ – auch vor Vokal ohne Apostroph." },
      { "text": "Dov'è ___ zucchero?", "answer": "lo", "options": ["lo", "il", "la"], "de": "Wo ist der Zucker?", "why": "Vor z steht „lo“." }
    ]
  },
  {
    "id": "subjektpronomen", "topic": "Pronomen", "rule": "verbform",
    "title": "Subjektpronomen: io, tu, lui …",
    "intro": "Meist lässt man das Pronomen weg – die Verbendung zeigt schon, wer gemeint ist. Man benutzt es nur zur Betonung oder Klarheit.",
