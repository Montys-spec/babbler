      ["Sie (höflich)", "Lei", "è"],
      ["wir", "noi", "siamo"],
      ["ihr", "voi", "siete"],
      ["sie (Mehrzahl)", "loro", "sono"]
    ] },
    "tips": [
      "Die Höflichkeitsform „Lei“ (Sie) steht mit der 3. Person Einzahl: „Lei è italiano?“ – Sind Sie Italiener?",
      "„Sono“ heißt „ich bin“ und „sie sind“ – der Zusammenhang entscheidet."
    ],
    "exercises": [
      { "text": "___ siamo amici.", "answer": "Noi", "options": ["Noi", "Voi", "Loro"], "de": "Wir sind Freunde.", "why": "„siamo“ gehört zu „noi“ (wir)." },
      { "text": "___ sei stanco?", "answer": "Tu", "options": ["Tu", "Io", "Lui"], "de": "Bist du müde?", "why": "„sei“ = du bist → „tu“." },
      { "text": "Scusi, ___ è il signor Rossi?", "answer": "Lei", "options": ["Lei", "Tu", "Voi"], "de": "Entschuldigung, sind Sie Herr Rossi?", "why": "Höflich (Sie) = „Lei“ mit der 3. Person." },
      { "text": "Io ___ tedesco.", "answer": "sono", "options": ["sono", "è", "sei"], "de": "Ich bin Deutscher.", "why": "io → sono." },
      { "text": "Voi ___ di Milano?", "answer": "siete", "options": ["siete", "sono", "siamo"], "de": "Seid ihr aus Mailand?", "why": "voi → siete." },
      { "text": "Marco e Anna? ___ sono in vacanza.", "answer": "Loro", "options": ["Loro", "Lui", "Noi"], "de": "Marco und Anna? Sie sind im Urlaub.", "why": "Mehrere Personen (sie) = „loro“." },
      { "text": "Lei ___ medico.", "answer": "è", "options": ["è", "e", "sei"], "de": "Sie ist Ärztin.", "why": "lei → „è“ (mit Akzent; „e“ heißt „und“)." },
      { "text": "Noi ___ in ufficio.", "answer": "siamo", "options": ["siamo", "sono", "siete"], "de": "Wir sind im Büro.", "why": "noi → siamo." }
    ]
  },
  {
    "id": "essere-avere", "topic": "Verben & Adverbien", "rule": "verbform",
    "title": "essere und avere",
    "intro": "Die zwei wichtigsten Verben sind unregelmäßig. Man braucht sie auch für das Perfekt.",
    "table": { "head": ["", "essere (sein)", "avere (haben)"], "rows": [
      ["io", "sono", "ho"],
      ["tu", "sei", "hai"],
      ["lui / lei / Lei", "è", "ha"],
      ["noi", "siamo", "abbiamo"],
      ["voi", "siete", "avete"],
      ["loro", "sono", "hanno"]
    ] },
    "tips": [
      "Das h in ho, hai, ha, hanno spricht man nicht – es unterscheidet nur in der Schrift: ho (ich habe) / o (oder), ha (hat) / a (nach).",
      "Alter, Hunger, Durst und Angst „hat“ man: ho vent'anni, ho fame, ho sete, ho paura."
    ],
    "exercises": [
      { "text": "Io ___ un cane.", "answer": "ho", "options": ["ho", "o", "sono"], "de": "Ich habe einen Hund.", "why": "io → ho (mit h)." },
      { "text": "Loro ___ due figli.", "answer": "hanno", "options": ["hanno", "anno", "sono"], "de": "Sie haben zwei Kinder.", "why": "loro → hanno (mit h; „anno“ heißt Jahr)." },
      { "text": "Tu ___ molto gentile.", "answer": "sei", "options": ["sei", "hai", "è"], "de": "Du bist sehr nett.", "why": "tu → sei." },
      { "text": "Noi ___ fame.", "answer": "abbiamo", "options": ["abbiamo", "siamo", "avete"], "de": "Wir haben Hunger.", "why": "Hunger „hat“ man: noi → abbiamo." },
      { "text": "Lei ___ trent'anni.", "answer": "ha", "options": ["ha", "a", "è"], "de": "Sie ist dreißig Jahre alt.", "why": "Alter mit avere: „ha trent'anni“." },
      { "text": "Voi ___ stanchi?", "answer": "siete", "options": ["siete", "avete", "sono"], "de": "Seid ihr müde?", "why": "voi → siete." },
      { "text": "Il museo ___ chiuso.", "answer": "è", "options": ["è", "ha", "e"], "de": "Das Museum ist geschlossen.", "why": "es ist = „è“ (mit Akzent)." },
      { "text": "Tu ___ paura dei cani?", "answer": "hai", "options": ["hai", "ai", "sei"], "de": "Hast du Angst vor Hunden?", "why": "Angst „hat“ man: tu → hai." }
    ]
  },
