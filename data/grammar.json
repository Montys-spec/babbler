  {
    "id": "praepositionen", "topic": "Präpositionen", "rule": "praeposition",
    "title": "Präpositionen: di, a, da, in, con, su, per, tra",
    "intro": "Präpositionen werden oft anders benutzt als im Deutschen. Die wichtigsten Regeln:",
    "table": { "head": ["Präposition", "Gebrauch", "Beispiel"], "rows": [
      ["di", "von · aus (Herkunft mit essere)", "il libro di Marco · sono di Berlino"],
      ["a", "nach / in + Stadt · um + Uhrzeit", "vado a Roma · alle otto"],
      ["in", "nach / in + Land · Verkehrsmittel", "vado in Italia · in treno"],
      ["da", "von … her · zu (Person) · seit", "vengo da Milano · vado da Luca · da due anni"],
      ["con", "mit", "con gli amici"],
      ["su", "auf · über", "sul tavolo"],
      ["per", "für · nach (Richtung)", "per te · il treno per Roma"],
      ["tra / fra", "zwischen · in (zeitlich)", "tra due giorni"]
    ] },
    "tips": [
      "Zu jemandem gehen: „da“ – vado da Luca, vado dal dentista.",
      "Seit: „da“ mit Präsens – abito qui da tre anni (ich wohne seit drei Jahren hier)."
    ],
    "exercises": [
      { "text": "Vado ___ Roma.", "answer": "a", "options": ["a", "in", "da"], "de": "Ich fahre nach Rom.", "why": "Stadt → „a“." },
      { "text": "Andiamo ___ Spagna.", "answer": "in", "options": ["in", "a", "da"], "de": "Wir fahren nach Spanien.", "why": "Land → „in“." },
      { "text": "Sono ___ Berlino.", "answer": "di", "options": ["di", "per", "con"], "de": "Ich bin aus Berlin (stamme von dort).", "why": "Herkunft mit essere: „sono di …“." },
      { "text": "Abito qui ___ tre anni.", "answer": "da", "options": ["da", "per", "di"], "de": "Ich wohne seit drei Jahren hier.", "why": "seit = „da“ mit Präsens." },
      { "text": "Il treno ___ Napoli parte alle nove.", "answer": "per", "options": ["per", "di", "con"], "de": "Der Zug nach Neapel fährt um neun ab.", "why": "Ziel eines Zuges oder Flugs: „per“." },
      { "text": "Esco ___ i miei amici.", "answer": "con", "options": ["con", "per", "tra"], "de": "Ich gehe mit meinen Freunden aus.", "why": "mit = „con“." },
      { "text": "Ci vediamo ___ due giorni.", "answer": "tra", "options": ["tra", "da", "di"], "de": "Wir sehen uns in zwei Tagen.", "why": "in (zeitlich, Zukunft) = „tra / fra“." },
      { "text": "Vado al lavoro ___ macchina.", "answer": "in", "options": ["in", "con", "a"], "de": "Ich fahre mit dem Auto zur Arbeit.", "why": "Verkehrsmittel ohne Artikel: „in macchina“." }
    ]
  },
