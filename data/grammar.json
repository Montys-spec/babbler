      { "text": "Le case sono ___.", "answer": "grandi", "options": ["grandi", "grande", "grandie"], "de": "Die Häuser sind groß.", "why": "Adjektive auf -e: Mehrzahl -i – für beide Geschlechter." },
      { "text": "Ho una giacca ___.", "answer": "verde", "options": ["verde", "verda", "verdo"], "de": "Ich habe eine grüne Jacke.", "why": "„verde“ endet auf -e → in der Einzahl gleich für m und w." },
      { "text": "Le scarpe ___ sono care.", "answer": "bianche", "options": ["bianche", "bianchi", "bianca"], "de": "Die weißen Schuhe sind teuer.", "why": "weiblich Mehrzahl, -ca → -che." },
      { "text": "È un libro molto ___.", "answer": "interessante", "options": ["interessante", "interessanto", "interessanta"], "de": "Es ist ein sehr interessantes Buch.", "why": "Adjektiv auf -e: „interessante“ für m und w." },
      { "text": "Abbiamo due gatti ___.", "answer": "neri", "options": ["neri", "nere", "nero"], "de": "Wir haben zwei schwarze Katzen.", "why": "„gatti“ ist männlich Mehrzahl → „neri“." },
      { "text": "Sono ragazze ___.", "answer": "simpatiche", "options": ["simpatiche", "simpatici", "simpatica"], "de": "Das sind nette Mädchen.", "why": "weiblich Mehrzahl: -ca → -che." }
    ]
  },
