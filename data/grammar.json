      { "text": "___ zii arrivano domani.", "answer": "Gli", "options": ["Gli", "I", "Le"], "de": "Die Onkel kommen morgen.", "why": "„lo zio“ → Mehrzahl „gli zii“." },
      { "text": "Mi piacciono le ___ italiane.", "answer": "città", "options": ["città", "citte", "cittì"], "de": "Mir gefallen die italienischen Städte.", "why": "Wörter mit Akzent am Ende bleiben gleich." },
      { "text": "Ho visto due ___ al cinema.", "answer": "film", "options": ["film", "filmi", "filme"], "de": "Ich habe zwei Filme im Kino gesehen.", "why": "Fremdwörter bleiben in der Mehrzahl gleich." },
      { "text": "Compro sei ___.", "answer": "uova", "options": ["uova", "uovi", "uove"], "de": "Ich kaufe sechs Eier.", "why": "Unregelmäßig: l'uovo → le uova." },
      { "text": "___ amiche di Sara sono qui.", "answer": "Le", "options": ["Le", "Gli", "I"], "de": "Saras Freundinnen sind hier.", "why": "Weiblich Mehrzahl: immer „le“." }
    ]
  },
