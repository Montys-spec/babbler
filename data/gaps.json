[
  { "cat": "Begrüßung & Höflichkeit", "level": 1, "text": "Ciao, come ___?", "answer": "stai", "options": ["stai", "sei", "stare"], "de": "Hallo, wie geht es dir?", "why": "Wie geht's? = „come stai?“ (von stare).", "rule": "verbform" },
  { "cat": "Begrüßung & Höflichkeit", "level": 1, "text": "Mi ___ Monty.", "answer": "chiamo", "options": ["chiamo", "chiama", "chiami"], "de": "Ich heiße Monty.", "why": "io → chiamo.", "rule": "verbform" },
  { "cat": "Begrüßung & Höflichkeit", "level": 2, "text": "Scusi, ___ tedesco?", "answer": "parla", "options": ["parla", "parli", "parlo"], "de": "Entschuldigung, sprechen Sie Deutsch?", "why": "Höflichkeitsform (Lei) → 3. Person: „parla“.", "rule": "verbform" },
  { "cat": "Begrüßung & Höflichkeit", "level": 2, "text": "Grazie ___ l'aiuto!", "answer": "per", "options": ["per", "di", "a"], "de": "Danke für die Hilfe!", "why": "Danke für … = „grazie per …“.", "rule": "praeposition" },
  { "cat": "Begrüßung & Höflichkeit", "level": 3, "text": "Mi dispiace, non ___ capito.", "answer": "ho", "options": ["ho", "sono", "abbia"], "de": "Es tut mir leid, ich habe es nicht verstanden.", "why": "„capire“ bildet die Vergangenheit mit „avere“: „ho capito“.", "rule": "hilfsverb" },

  { "cat": "Zahlen", "level": 1, "text": "Ho due ___.", "answer": "fratelli", "options": ["fratelli", "fratello", "fratelle"], "de": "Ich habe zwei Brüder.", "why": "Nach „due“ steht die Mehrzahl: „fratelli“.", "rule": "mehrzahl" },
  { "cat": "Zahlen", "level": 1, "text": "___ le tre.", "answer": "Sono", "options": ["Sono", "È", "Ha"], "de": "Es ist drei Uhr.", "why": "Uhrzeiten: „sono le …“ (nur bei ein Uhr: „è l'una“).", "rule": "verbform" },
  { "cat": "Zahlen", "level": 2, "text": "Ho venti ___.", "answer": "anni", "options": ["anni", "anno", "ani"], "de": "Ich bin zwanzig Jahre alt.", "why": "Alter mit „avere“ und der Mehrzahl „anni“.", "rule": "mehrzahl" },
  { "cat": "Zahlen", "level": 2, "text": "Abito al ___ piano.", "answer": "terzo", "options": ["terzo", "tre", "terza"], "de": "Ich wohne im dritten Stock.", "why": "Ordnungszahl, männlich wie „piano“: „terzo“.", "rule": "angleichung" },
  { "cat": "Zahlen", "level": 3, "text": "Il treno parte ___ sette.", "answer": "alle", "options": ["alle", "a le", "al"], "de": "Der Zug fährt um sieben ab.", "why": "Uhrzeit: „a“ + „le“ → „alle“.", "rule": "praeposition" },

  { "cat": "Zeit & Kalender", "level": 1, "text": "Oggi ___ lunedì.", "answer": "è", "options": ["è", "e", "ha"], "de": "Heute ist Montag.", "why": "„è“ (ist) hat einen Akzent; „e“ ohne Akzent heißt „und“.", "rule": "schreibung" },
  { "cat": "Zeit & Kalender", "level": 1, "text": "Domani io ___ al mare.", "answer": "vado", "options": ["vado", "va", "andare"], "de": "Morgen fahre ich ans Meer.", "why": "io → vado (von andare).", "rule": "verbform" },
  { "cat": "Zeit & Kalender", "level": 2, "text": "Il sabato vado ___ mercato.", "answer": "al", "options": ["al", "a", "in"], "de": "Samstags gehe ich auf den Markt.", "why": "„a“ + „il“ → „al“.", "rule": "praeposition" },
  { "cat": "Zeit & Kalender", "level": 2, "text": "Ci vediamo la ___ settimana.", "answer": "prossima", "options": ["prossima", "prossimo", "prossime"], "de": "Wir sehen uns nächste Woche.", "why": "„settimana“ ist weiblich Einzahl → „prossima“.", "rule": "angleichung" },
  { "cat": "Zeit & Kalender", "level": 3, "text": "Ieri ___ tornato tardi.", "answer": "sono", "options": ["sono", "ho", "sto"], "de": "Gestern bin ich spät zurückgekommen.", "why": "„tornare“ bildet die Vergangenheit mit „essere“: „sono tornato“.", "rule": "hilfsverb" },

  { "cat": "Essen & Trinken", "level": 1, "text": "___ caffè è caldo.", "answer": "Il", "options": ["Il", "La", "Lo"], "de": "Der Kaffee ist heiß.", "why": "„caffè“ ist männlich, vor c steht „il“.", "rule": "artikel" },
  { "cat": "Essen & Trinken", "level": 1, "text": "La pizza è ___.", "answer": "buona", "options": ["buona", "buono", "bene"], "de": "Die Pizza ist gut.", "why": "„pizza“ ist weiblich → „buona“; „bene“ ist ein Adverb.", "rule": "angleichung" },
  { "cat": "Essen & Trinken", "level": 2, "text": "Mi ___ le fragole.", "answer": "piacciono", "options": ["piacciono", "piace", "piaccio"], "de": "Ich mag Erdbeeren.", "why": "Das Gemochte ist Mehrzahl → „mi piacciono“.", "rule": "verbform" },
  { "cat": "Essen & Trinken", "level": 2, "text": "Ho ___, mangiamo qualcosa?", "answer": "fame", "options": ["fame", "affamato", "mangiare"], "de": "Ich habe Hunger, essen wir etwas?", "why": "Hunger haben = „avere fame“.", "rule": "wortwahl" },
  { "cat": "Essen & Trinken", "level": 3, "text": "Ieri sera ___ mangiato la pizza.", "answer": "abbiamo", "options": ["abbiamo", "siamo", "avete"], "de": "Gestern Abend haben wir Pizza gegessen.", "why": "„mangiare“ bildet die Vergangenheit mit „avere“; wir → „abbiamo“.", "rule": "hilfsverb" },

  { "cat": "Familie & Menschen", "level": 1, "text": "Lei è ___ sorella.", "answer": "mia", "options": ["mia", "la mia", "mio"], "de": "Sie ist meine Schwester.", "why": "Bei Verwandten in der Einzahl fällt der Artikel weg: „mia sorella“.", "rule": "artikel" },
  { "cat": "Familie & Menschen", "level": 1, "text": "Come si chiama ___ madre?", "answer": "tua", "options": ["tua", "tuo", "tue"], "de": "Wie heißt deine Mutter?", "why": "„madre“ ist weiblich → „tua“.", "rule": "angleichung" },
  { "cat": "Familie & Menschen", "level": 2, "text": "I miei genitori ___ a Roma.", "answer": "abitano", "options": ["abitano", "abita", "abitiamo"], "de": "Meine Eltern wohnen in Rom.", "why": "sie (Mehrzahl) → „abitano“.", "rule": "verbform" },
  { "cat": "Familie & Menschen", "level": 2, "text": "Ho ___ fratello e due sorelle.", "answer": "un", "options": ["un", "una", "uno"], "de": "Ich habe einen Bruder und zwei Schwestern.", "why": "Männlich vor f → „un“.", "rule": "artikel" },
  { "cat": "Familie & Menschen", "level": 3, "text": "I nonni vengono ogni ___.", "answer": "domenica", "options": ["domenica", "domeniche", "domenico"], "de": "Die Großeltern kommen jeden Sonntag.", "why": "Nach „ogni“ (jeder) steht immer die Einzahl.", "rule": "mehrzahl" },

  { "cat": "Körper & Gesundheit", "level": 1, "text": "Ho mal ___ testa.", "answer": "di", "options": ["di", "a", "della"], "de": "Ich habe Kopfschmerzen.", "why": "Feste Wendung: „mal di testa“.", "rule": "praeposition" },
  { "cat": "Körper & Gesundheit", "level": 1, "text": "Mi fa male ___ gamba.", "answer": "la", "options": ["la", "il", "lo"], "de": "Mir tut das Bein weh.", "why": "„gamba“ ist weiblich → „la“.", "rule": "artikel" },
  { "cat": "Körper & Gesundheit", "level": 2, "text": "Devo ___ dal medico.", "answer": "andare", "options": ["andare", "vado", "andato"], "de": "Ich muss zum Arzt gehen.", "why": "Nach „devo“ (ich muss) folgt die Grundform.", "rule": "verbform" },
  { "cat": "Körper & Gesundheit", "level": 2, "text": "La farmacia è ___.", "answer": "chiusa", "options": ["chiusa", "chiuso", "chiudere"], "de": "Die Apotheke ist geschlossen.", "why": "„farmacia“ ist weiblich → „chiusa“.", "rule": "angleichung" },
  { "cat": "Körper & Gesundheit", "level": 3, "text": "Le mani sono ___.", "answer": "fredde", "options": ["fredde", "freddi", "fredda"], "de": "Die Hände sind kalt.", "why": "„le mani“ ist weiblich Mehrzahl (trotz -o) → „fredde“.", "rule": "angleichung" },

  { "cat": "Haus & Wohnen", "level": 1, "text": "___ casa è grande.", "answer": "La", "options": ["La", "Il", "Lo"], "de": "Das Haus ist groß.", "why": "„casa“ ist weiblich → „la“.", "rule": "artikel" },
  { "cat": "Haus & Wohnen", "level": 1, "text": "Dov'è ___ bagno?", "answer": "il", "options": ["il", "lo", "la"], "de": "Wo ist das Bad?", "why": "Männlich vor b → „il“; „lo“ nur vor s + Konsonant, z, gn, ps.", "rule": "artikel" },
  { "cat": "Haus & Wohnen", "level": 2, "text": "Le chiavi sono ___ tavolo.", "answer": "sul", "options": ["sul", "su il", "nel"], "de": "Die Schlüssel liegen auf dem Tisch.", "why": "„su“ + „il“ → „sul“.", "rule": "praeposition" },
  { "cat": "Haus & Wohnen", "level": 2, "text": "Il nostro appartamento ha tre ___.", "answer": "camere", "options": ["camere", "camera", "cameri"], "de": "Unsere Wohnung hat drei Zimmer.", "why": "Mehrzahl von „camera“: „camere“.", "rule": "mehrzahl" },
  { "cat": "Haus & Wohnen", "level": 3, "text": "Quando ___ entrato, la luce era accesa.", "answer": "sono", "options": ["sono", "ho", "avevo"], "de": "Als ich hereinkam, war das Licht an.", "why": "„entrare“ bildet die Vergangenheit mit „essere“.", "rule": "hilfsverb" },

  { "cat": "Stadt & Reisen", "level": 1, "text": "Dov'è ___ stazione?", "answer": "la", "options": ["la", "il", "lo"], "de": "Wo ist der Bahnhof?", "why": "„stazione“ ist weiblich, wie alle Wörter auf -zione.", "rule": "artikel" },
  { "cat": "Stadt & Reisen", "level": 1, "text": "Vado ___ destra.", "answer": "a", "options": ["a", "in", "da"], "de": "Ich gehe nach rechts.", "why": "rechts / links = „a destra“ / „a sinistra“.", "rule": "praeposition" },
  { "cat": "Stadt & Reisen", "level": 2, "text": "Andiamo in centro ___ bicicletta.", "answer": "in", "options": ["in", "con", "a"], "de": "Wir fahren mit dem Fahrrad in die Innenstadt.", "why": "Verkehrsmittel mit „in“: „in bicicletta“, „in treno“.", "rule": "praeposition" },
  { "cat": "Stadt & Reisen", "level": 2, "text": "___ biglietto per Milano, per favore.", "answer": "Un", "options": ["Un", "Una", "Uno"], "de": "Eine Fahrkarte nach Mailand, bitte.", "why": "„biglietto“ ist männlich, vor b → „un“.", "rule": "artikel" },
  { "cat": "Stadt & Reisen", "level": 3, "text": "L'anno scorso ___ andati in Sicilia.", "answer": "siamo", "options": ["siamo", "abbiamo", "avevamo"], "de": "Letztes Jahr sind wir nach Sizilien gefahren.", "why": "„andare“ bildet die Vergangenheit mit „essere“: „siamo andati“.", "rule": "hilfsverb" },

  { "cat": "Kleidung & Farben", "level": 1, "text": "La giacca è ___.", "answer": "nera", "options": ["nera", "nero", "neri"], "de": "Die Jacke ist schwarz.", "why": "„giacca“ ist weiblich → „nera“.", "rule": "angleichung" },
  { "cat": "Kleidung & Farben", "level": 1, "text": "Ho le scarpe ___.", "answer": "nuove", "options": ["nuove", "nuovi", "nuova"], "de": "Ich habe neue Schuhe.", "why": "„scarpe“ ist weiblich Mehrzahl → „nuove“.", "rule": "angleichung" },
  { "cat": "Kleidung & Farben", "level": 2, "text": "___ pantaloni sono troppo corti.", "answer": "Questi", "options": ["Questi", "Questo", "Queste"], "de": "Diese Hose ist zu kurz.", "why": "„pantaloni“ ist männlich Mehrzahl → „questi“.", "rule": "angleichung" },
  { "cat": "Kleidung & Farben", "level": 2, "text": "Porto sempre ___ occhiali.", "answer": "gli", "options": ["gli", "i", "le"], "de": "Ich trage immer eine Brille.", "why": "Männlich Mehrzahl vor Vokal → „gli“.", "rule": "artikel" },
  { "cat": "Kleidung & Farben", "level": 3, "text": "Le magliette ___ costano meno.", "answer": "bianche", "options": ["bianche", "bianchi", "bianca"], "de": "Die weißen T-Shirts kosten weniger.", "why": "Weiblich Mehrzahl, -ca wird zu -che: „bianche“.", "rule": "angleichung" },

  { "cat": "Natur & Wetter", "level": 1, "text": "Oggi ___.", "answer": "piove", "options": ["piove", "piova", "pioggia"], "de": "Heute regnet es.", "why": "es regnet = „piove“; „la pioggia“ = der Regen.", "rule": "verbform" },
  { "cat": "Natur & Wetter", "level": 1, "text": "___ il sole.", "answer": "C'è", "options": ["C'è", "Ci è", "Ce"], "de": "Die Sonne scheint.", "why": "„ci“ + „è“ → „c'è“.", "rule": "schreibung" },
  { "cat": "Natur & Wetter", "level": 2, "text": "Il mio gatto ___ tutto il giorno.", "answer": "dorme", "options": ["dorme", "dormi", "dormo"], "de": "Meine Katze schläft den ganzen Tag.", "why": "er/sie (il gatto) → „dorme“.", "rule": "verbform" },
  { "cat": "Natur & Wetter", "level": 2, "text": "In montagna c'è ___ neve.", "answer": "molta", "options": ["molta", "molto", "molte"], "de": "In den Bergen liegt viel Schnee.", "why": "„molto“ vor einem Nomen passt sich an: „neve“ ist weiblich → „molta“.", "rule": "angleichung" },
  { "cat": "Natur & Wetter", "level": 3, "text": "Domani fa ___ tempo.", "answer": "bel", "options": ["bel", "bello", "bella"], "de": "Morgen ist schönes Wetter.", "why": "Vor einem Konsonanten wird „bello“ zu „bel“.", "rule": "angleichung" },

  { "cat": "Arbeit & Schule", "level": 1, "text": "Lavoro in ___ ufficio.", "answer": "un", "options": ["un", "una", "uno"], "de": "Ich arbeite in einem Büro.", "why": "Männlich vor Vokal → „un“ (ohne Apostroph).", "rule": "artikel" },
  { "cat": "Arbeit & Schule", "level": 1, "text": "Il libro è ___.", "answer": "interessante", "options": ["interessante", "interesante", "interessanto"], "de": "Das Buch ist interessant.", "why": "„interessante“: Doppel-s und Endung -e.", "rule": "schreibung" },
  { "cat": "Arbeit & Schule", "level": 2, "text": "La lezione ___ alle nove.", "answer": "comincia", "options": ["comincia", "cominciano", "comincio"], "de": "Der Unterricht beginnt um neun.", "why": "„la lezione“ (sie) → „comincia“.", "rule": "verbform" },
  { "cat": "Arbeit & Schule", "level": 2, "text": "Non capisco ___ parola.", "answer": "questa", "options": ["questa", "questo", "queste"], "de": "Ich verstehe dieses Wort nicht.", "why": "„parola“ ist weiblich → „questa“.", "rule": "angleichung" },
  { "cat": "Arbeit & Schule", "level": 3, "text": "___ problema è che non ho tempo.", "answer": "Il", "options": ["Il", "La", "Lo"], "de": "Das Problem ist, dass ich keine Zeit habe.", "why": "„problema“ ist männlich (trotz -a) → „il problema“.", "rule": "artikel" },

  { "cat": "Wichtige Verben", "level": 1, "text": "Noi ___ amici.", "answer": "siamo", "options": ["siamo", "sono", "siete"], "de": "Wir sind Freunde.", "why": "wir → „siamo“.", "rule": "verbform" },
  { "cat": "Wichtige Verben", "level": 1, "text": "___ un cane?", "answer": "Hai", "options": ["Hai", "Ai", "Hei"], "de": "Hast du einen Hund?", "why": "du hast = „hai“, mit h.", "rule": "schreibung" },
  { "cat": "Wichtige Verben", "level": 2, "text": "Voglio ___ l'italiano.", "answer": "imparare", "options": ["imparare", "imparo", "imparato"], "de": "Ich will Italienisch lernen.", "why": "Nach „voglio“ (ich will) folgt die Grundform.", "rule": "verbform" },
  { "cat": "Wichtige Verben", "level": 2, "text": "___ dove abita Luca?", "answer": "Sai", "options": ["Sai", "Conosci", "Sei"], "de": "Weißt du, wo Luca wohnt?", "why": "etwas wissen = „sapere“; jemanden kennen = „conoscere“.", "rule": "wortwahl" },
  { "cat": "Wichtige Verben", "level": 3, "text": "Ho ___ le chiavi a casa.", "answer": "dimenticato", "options": ["dimenticato", "dimenticata", "dimenticare"], "de": "Ich habe die Schlüssel zu Hause vergessen.", "why": "Mit „avere“ endet das Partizip hier auf -o: „ho dimenticato“.", "rule": "verbform" },

  { "cat": "Eigenschaften", "level": 1, "text": "Mio padre è ___.", "answer": "stanco", "options": ["stanco", "stanca", "stanchi"], "de": "Mein Vater ist müde.", "why": "„padre“ ist männlich Einzahl → „stanco“.", "rule": "angleichung" },
  { "cat": "Eigenschaften", "level": 1, "text": "Roma è una città molto ___.", "answer": "bella", "options": ["bella", "bello", "belle"], "de": "Rom ist eine sehr schöne Stadt.", "why": "„città“ ist weiblich → „bella“.", "rule": "angleichung" },
  { "cat": "Eigenschaften", "level": 2, "text": "Questi pomodori sono ___.", "answer": "freschi", "options": ["freschi", "fresche", "freschio"], "de": "Diese Tomaten sind frisch.", "why": "Männlich Mehrzahl, -co wird zu -chi: „freschi“.", "rule": "angleichung" },
  { "cat": "Eigenschaften", "level": 2, "text": "Mio fratello è più giovane ___ me.", "answer": "di", "options": ["di", "che", "da"], "de": "Mein Bruder ist jünger als ich.", "why": "Vergleich mit einer Person: „più … di“.", "rule": "praeposition" },
  { "cat": "Eigenschaften", "level": 3, "text": "Le ragazze erano ___.", "answer": "contente", "options": ["contente", "contenti", "contenta"], "de": "Die Mädchen waren froh.", "why": "„ragazze“ ist weiblich Mehrzahl → „contente“.", "rule": "angleichung" },

  { "cat": "Kleine Wörter", "level": 1, "text": "Vieni con ___?", "answer": "me", "options": ["me", "io", "mi"], "de": "Kommst du mit mir?", "why": "Nach Präpositionen steht „me“: „con me“.", "rule": "wortwahl" },
  { "cat": "Kleine Wörter", "level": 1, "text": "___ no?", "answer": "Perché", "options": ["Perché", "Perchè", "Perche"], "de": "Warum nicht?", "why": "„perché“ schreibt man mit é (Akzent nach rechts oben).", "rule": "schreibung" },
  { "cat": "Kleine Wörter", "level": 2, "text": "___ anni hai?", "answer": "Quanti", "options": ["Quanti", "Quanto", "Quante"], "de": "Wie alt bist du?", "why": "„anni“ ist männlich Mehrzahl → „quanti“.", "rule": "angleichung" },
  { "cat": "Kleine Wörter", "level": 2, "text": "Non ho ___ da fare.", "answer": "niente", "options": ["niente", "qualcosa", "tutto"], "de": "Ich habe nichts zu tun.", "why": "nichts = „non … niente“.", "rule": "wortwahl" },
  { "cat": "Kleine Wörter", "level": 3, "text": "Non so ___ arriva.", "answer": "quando", "options": ["quando", "quanto", "quale"], "de": "Ich weiß nicht, wann er kommt.", "why": "wann = „quando“; „quanto“ = wie viel.", "rule": "wortwahl" }
]
